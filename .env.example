# Kopyalayın: copy .env.example .env.local
# Yerel PostgreSQL örneği (pgAdmin / psql / araçlar için)
DATABASE_URL=postgresql://postgres:SIFRENIZ@localhost:5432/ilsasupport
#
# Şemayı (tablolar) oluşturmak için proje kökünde:
#   npm install
#   npm run db:schema
# (.env.local içinde DATABASE_URL olmalı; sql/00_README.txt sırasına bakın.)

# --- Uzak MySQL → PostgreSQL senkron (isteğe bağlı; varsayılan KAPALI) ---
# Şimdilik gerek yoksa hiçbir MYSQL_* tanımlamayın. sync:mysql komutu çıkış yapar.
# Açmak için: MYSQL_SYNC_ENABLED=1 ve aşağıdaki bağlantı bilgileri, sonra: npm run sync:mysql
# MYSQL_SYNC_ENABLED=1
# MYSQL_HOST=mysql.ornek.com
# MYSQL_PORT=3306
# MYSQL_USER=okuyucu
# MYSQL_PASSWORD=...
# MYSQL_DATABASE=ilsasup_eski
# İsteğe bağlı SSL: MYSQL_SSL=1
# Tablo adları farklıysa: MYSQL_TABLE_KATEGORILER=kategoriler  MYSQL_TABLE_BILGI=bilgi
# Deneme: npm run sync:mysql -- --dry-run
# Zorla (bayrak): npm run sync:mysql -- --force

# Hono/Deno API (src/supabase/functions/server)
# JWT_SECRET=...
# Üretim: ILSA_PRODUCTION=true iken JWT_SECRET zorunludur (sunucu açılışta kontrol).
# ILSA_PRODUCTION=true
#
# Kurulum uçları (POST setup-admin, setup-all-brands, setup-all-demo-users):
# Boş bırakılırsa yerel demo butonları ek başlık istemez. Üretimde mutlaka uzun rastgele değer verin;
# tarayıcıdan aynı değeri göndermek için (yalnızca güvenilir ortam) VITE_SETUP_SECRET kullanılabilir.
# SETUP_SECRET=uzun-rastgele-dize
# (Vite .env.local) VITE_SETUP_SECRET=aynı-değer
# PORT=8787
# SEARCH_CACHE_SEC=90
# JWT_PURGE_INTERVAL_MS=21600000
# HOST=0.0.0.0          # varsayılan: tüm arayüzler (dış IP / ağ). Sadece yerel: HOST=127.0.0.1
# JSON_STORAGE_DIR=./storage/json-files

# Vite geliştirme sunucusu — varsayılan TCP 80 (Windows’ta genelde yönetici PowerShell gerekir).
# 80 kullanılamıyorsa: VITE_DEV_PORT=5173
# 80’de kalmayı zorunlu tutmayı kapatmak (meşgulse sıradaki port): VITE_DEV_STRICT_PORT=0
#
# HMR: Varsayılan aynı origin (localhost veya girdiğiniz host ile uyumlu). Sorun devam ederse tamamen kapatın:
# VITE_DISABLE_HMR=1
#
# VPS’e dış IP / alan adıyla bağlanırken canlı yenileme (WS) için otomatik makine IPv4’ü:
# VITE_AUTO_HMR_HOST=1
# veya doğrudan: VITE_HMR_HOST=194.62.52.140
#
# HTTPS reverse proxy arkasında:
# VITE_HMR_PROTOCOL=wss
# VITE_HMR_CLIENT_PORT=443
# VITE_HMR_HOST=ilsasupport.com
#
# Vite ön uç — canonical, Open Graph ve hreflang için kamuya açık site kökü (sonunda / olmadan).
# Örnek: https://ilsasupport.com — boş bırakılırsa tarayıcıda açılan origin kullanılır (yerel geliştirme için uygun).
# VITE_PUBLIC_SITE_URL=https://ilsasupport.com
#
# Vite ön uç — API kökü (varsayılan http://localhost:8787)
# VITE_API_BASE_URL=http://localhost:8787
#
# Dış IP / başka PC’den arayüz: npm run dev → http://SUNUCU_IP/ (varsayılan port 80) veya VITE_DEV_PORT ile başka port
# Açılmıyorsa sunucuda (YÖNETİCİ): npm run diagnose:remote — veya:
#   powershell -ExecutionPolicy Bypass -File .\scripts\diagnose-remote-dev.ps1 -PublicIp 194.62.52.140
# Sık nedenler: 80’de IIS (W3SVC), güvenlik duvarı, Vite’ın yönetici olmadan 80’e bağlanamaması, bulutta SG kuralı yok.
# (Güncel sunucu örneği: 194.62.52.140 — DNS ilsasupport.com bu IP’ye işaret etmeli.)
# (Vite host: true — tum arayuzler; API aynı makinede 8787 ise /make-server-* Vite proxy ile gider.)
#
# Windows’ta 80 için genelde yönetici gerekir: npm run dev:admin  veya  npm run dev:full:admin  (API+Vite)
#   npm run windows:firewall-dev
# veya elle:
#   New-NetFirewallRule -DisplayName "ILSA Vite 80" -Direction Inbound -Action Allow -Protocol TCP -LocalPort 80 -Profile Any
#   (İsteğe bağlı alternatif port) New-NetFirewallRule -DisplayName "ILSA Vite 5173" -Direction Inbound -Action Allow -Protocol TCP -LocalPort 5173 -Profile Any
#   New-NetFirewallRule -DisplayName "ILSA API 8787" -Direction Inbound -Action Allow -Protocol TCP -LocalPort 8787 -Profile Any
#
# Üretim önizleme (HMR yok): npm run build && npm run preview:lan
#
# Üretim derlemesinde API ayrı kökteyse build öncesi mutlaka ayarlayın:
# VITE_API_BASE_URL=https://api.ornek.com
# (API aynı kökteyse) VITE_API_BASE_URL=https://ilsasupport.com
