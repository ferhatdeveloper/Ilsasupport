# ILSA Support — üretim (Let's Encrypt otomatik)
# DNS: A @ ve www → bu sunucu (194.62.52.140)

{
	email admin@ilsasupport.com
}

# IP ile giris: sertifika yalnizca domain icin — siteyi domaine yonlendir
http://194.62.52.140 {
	redir https://ilsasupport.com{uri} permanent
}

https://194.62.52.140 {
	tls internal
	redir https://ilsasupport.com{uri} permanent
}

ilsasupport.com, www.ilsasupport.com {
	@www host www.ilsasupport.com
	redir @www https://ilsasupport.com{uri} permanent

	encode gzip zstd

	@api path /make-server-47081311/*
	handle @api {
		reverse_proxy 127.0.0.1:8787 {
			health_uri /make-server-47081311/health
			health_interval 10s
			health_timeout 5s
			fail_duration 30s
			max_fails 2
			transport http {
				read_timeout 90s
				write_timeout 90s
			}
		}
	}

	@downloads path /downloads/*
	handle @downloads {
		root * {$ILSA_ROOT}/build
		header Content-Disposition "attachment"
		file_server
	}

	# CMS yüklemeleri public/img altına yazılır; build'de yoksa SPA index.html döner (kırık görsel)
	@cms_uploads path /img/slayt/* /img/kategori/* /img/paket/*
	handle @cms_uploads {
		root * {$ILSA_ROOT}
		try_files /public{path} /build{path}
		file_server
	}

	handle {
		root * {$ILSA_ROOT}/build
		try_files {path} /index.html
		file_server
	}
}
